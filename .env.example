# ===== AirMic 服务端配置 =====
# 复制本文件为 .env 后修改：服务端启动时会自动读取项目根目录的 .env（已存在的环境变量优先）。
#    Windows: Copy-Item .env.example .env
#    Linux/macOS: cp .env.example .env

# 运行模式。生产部署请显式设置为 production（启用静态资源缓存、默认 info 日志）。
# 开发模式（npm run dev）不需要设置。
# NODE_ENV=production

# 监听地址与端口。反向代理后建议 HOST=127.0.0.1，只允许本机访问；直接对外暴露时用 0.0.0.0。
HOST=0.0.0.0
PORT=9811

# SQLite 数据库文件路径（相对路径以项目根目录为基准，也可以是绝对路径）。
# 首次启动会自动创建目录、数据库和表结构。
DATABASE_PATH=./data/airmic.db

# JWT 签名密钥。留空则首次启动自动生成并保存在数据库中（settings 表的 jwt_secret）。
# 生产环境建议设置为一段足够长的随机字符串（例如 node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）。
# 注意：修改该值会使所有现有登录会话失效。
JWT_SECRET=

# ===== 部署初始化 =====
# 初始化口令（可选）。设置后，首次部署访问 /setup 创建管理员时必须输入该口令；
# 初始化完成后不再生效（服务器已有管理员则 /setup 不可用）。
# 生成示例：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SETUP_TOKEN=

# 兼容旧部署的管理员引导（可选，推荐使用 /setup 初始化向导）。
# 仅在服务器还没有任何管理员账号时生效；若同名用户已存在，该用户会被提升为管理员。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== LiveKit SFU 语音中转（必填，语音的唯一链路）=====
# 浏览器直接连接的 LiveKit 信令地址：
#   - 本机开发：ws://localhost:7880（docker compose 默认）
#   - 生产环境：wss://livekit.example.com（必须 HTTPS/wss，且手机/局域网设备可访问）
# 初始化向导或管理后台保存的 LiveKit 配置优先；未在界面配置时回退到这里的值。
LIVEKIT_URL=ws://localhost:7880
# AirMic 签发访问令牌使用的 API Key / Secret，必须与 LiveKit 服务端 livekit.yaml 的 keys 完全一致。
# 生产环境务必修改（devkey/secret 仅用于本地开发，部署前必须换掉）。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# 可选：Docker Compose 中 LiveKit 镜像版本（默认 v1.13.11）
# LIVEKIT_VERSION=v1.13.11

# 反向代理（Nginx/Caddy/云厂商负载均衡）后请设置为 true，
# 以便通过 X-Forwarded-For 获取真实客户端 IP（用于封禁、审计、限流）。
# 不要在没有可信代理的情况下开启。
TRUST_PROXY=false

# 登录会话有效期：普通用户按天、游客按小时。
USER_SESSION_TTL_DAYS=30
GUEST_SESSION_TTL_HOURS=24

# HTTPS（可选）：同时提供 PEM 证书与私钥路径后以 HTTPS 启动。
# 浏览器只在 HTTPS 或 localhost 下允许使用麦克风（getUserMedia），且 LiveKit 通常也需要 wss。
# 局域网自签证书可用：node scripts/generate-cert.mjs
# 反向代理终止 TLS 时不需要设置这两项（Node 监听 127.0.0.1 的 HTTP 即可）。
SSL_KEY=
SSL_CERT=

# 前端构建产物目录（生产模式由 Fastify 托管；npm run build 生成 ./web/dist）
WEB_DIST=./web/dist

# 允许被代理的跨域来源（预留项，当前前后端同源部署，代码中未使用）
# CORS_ORIGIN=

# 日志级别: fatal|error|warn|info|debug|trace|silent
# 未设置时生产环境为 info，开发环境为 debug。
LOG_LEVEL=info

# ===== 备份脚本（scripts/backup.mjs）=====
# 备份输出目录与保留份数（相对项目根目录或绝对路径）。
# 常用命令：npm run backup
BACKUP_DIR=./backups
RETENTION=10

# ===== 自签证书脚本（scripts/generate-cert.mjs）=====
# 额外加入证书 SAN 的主机名/IP（逗号或空格分隔）；localhost/127.0.0.1/本机局域网 IPv4 会自动加入。
# CERT_HOSTS=
# 证书有效期（天）
# CERT_DAYS=825
# OpenSSL 可执行文件路径（Windows 未加入 PATH 时可指向 Git 自带的 openssl.exe）
# OPENSSL_BIN=C:/Program Files/Git/usr/bin/openssl.exe

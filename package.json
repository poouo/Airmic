{
  "name": "airmic",
  "version": "1.1.2",
  "private": true,
  "description": "AirMic — 网页版游戏语音开黑平台 (Web-based voice chat for gaming)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @airmic/server",
    "dev:web": "npm run dev -w @airmic/web",
    "build": "npm run build -w @airmic/shared && npm run build -w @airmic/server && npm run build -w @airmic/web",
    "start": "npm run start -w @airmic/server",
    "deploy": "node deploy/airmic-cli.mjs",
    "deploy:local": "node deploy/airmic-cli.mjs install --mode local",
    "deploy:docker": "node deploy/airmic-cli.mjs install --mode docker",
    "upgrade": "node deploy/airmic-cli.mjs upgrade",
    "test": "npm run test -w @airmic/server",
    "typecheck": "npm run typecheck -w @airmic/shared && npm run typecheck -w @airmic/server && npm run typecheck -w @airmic/web",
    "backup": "node scripts/backup.mjs",
    "cert": "node scripts/generate-cert.mjs",
    "test:e2e": "node e2e/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}